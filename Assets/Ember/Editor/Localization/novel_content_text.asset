  m_Name: novel_content_text
  m_EditorClassIdentifier: Ember.UIExtension.Editor::Ember.UIExtension.Editor.EmberLocalizationSource
  DisplayName: "\u5C0F\u8BF4\u5267\u60C5\u6587\u6848"
  TableId: novel_content_text
  Source: {fileID: 4900000, guid: f1a759d33b45658498b78d31173af725, type: 3}
  Definition: {fileID: 11400000, guid: 0542b0a98c308834ea5ddc72ed0b907e, type: 2}
  KeyColumn: key
  SourceLanguage: zh_Hans
  Languages:
  - zh_Hans
  - zh_Hant
  - ja
  - en
  TranslationContext: "\u89C6\u89C9\u5C0F\u8BF4\u5BF9\u767D\u4E0E\u89D2\u8272\u540D\u79F0\uFF1B\u9075\u5FAA\u4EBA\u7269\u79F0\u547C\u548C\u524D\u540E\u53F0\u8BCD\u8BED\u5883\u3002"
  Output: {fileID: 11400000, guid: 401328ae20bae1141947dda0cff9443b, type: 2}
  Reviews:
  - Key: character.alice
    SourceText: "\u5C0F\u827E"
    Pending: 0
  - Key: character.lin
    SourceText: "\u963F\u6797"
    Pending: 0
  - Key: character.lastlight_wan
    SourceText: "\u6797\u665A"
    Pending: 0
  - Key: character.lastlight_zhou
    SourceText: "\u5468\u781A"
    Pending: 0
  - Key: character.lastlight_inner
    SourceText: "\u6211\uFF08\u5185\u5FC3\uFF09"
    Pending: 0
  - Key: speaker.unknown
    SourceText: "\uFF1F\uFF1F\uFF1F"
    Pending: 0
  - Key: text.last_light_m5.sample_open_line_1
    SourceText: "\uFF08\u6709\u4E9B\u544A\u522B\uFF0C\u662F\u4ECE\u4E00\u76CF\u706F\u5F00\u59CB\u7684\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.sample_open_line_2
    SourceText: "\uFF08\u90A3\u5929\u508D\u665A\uFF0C\u98CE\u628A\u5929\u53F0\u7684\u94C1\u95E8\u5439\u5F97\u8F7B\u8F7B\u54CD\u3002\u6211\u8FD8\u4E0D\u77E5\u9053\uFF0C\u81EA\u5DF1\u4F1A\u5728\u8FD9\u91CC\u8BF4\u51FA\u540D\u5B57\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.sample_open_line_3
    SourceText: "\uFF08{playerName}\u3002\u9ED8\u5FF5\u4E00\u904D\uFF0C\u597D\u50CF\u8FDE\u90A3\u5E74\u590F\u5929\u7684\u6E29\u5EA6\u90FD\u60F3\u8D77\u6765\u4E86\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_intro_e4_title
    SourceText: "\u6700\u540E\u4E00\u76CF\u706F"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_001
    SourceText: "\u5929\u53F0\u7684\u95E8\u5728\u8EAB\u540E\u5408\u4E0A\u3002\u96E8\u540E\u7684\u680F\u6746\u8FD8\u7559\u7740\u6C34\u73E0\uFF0C\u8FDC\u5904\u4E00\u6392\u7A97\u6237\u9010\u6E10\u4EAE\u8D77\u6765\u3002\u6797\u665A\u7AD9\u5728\u6700\u540E\u4E00\u675F\u5915\u5149\u91CC\uFF0C\u6000\u4E2D\u62B1\u7740\u4E00\u4E2A\u6CA1\u6709\u7F72\u540D\u7684\u4FE1\u5C01\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_002
    SourceText: "\uFF08\u6211\u4EE5\u4E3A\u5979\u7EA6\u6211\u4E0A\u6765\uFF0C\u53EA\u662F\u4E3A\u4E86\u770B\u6700\u540E\u4E00\u6B21\u65E5\u843D\u3002\u76F4\u5230\u770B\u89C1\u4FE1\u5C01\u4E0A\u719F\u6089\u7684\u5B57\uFF0C\u6211\u624D\u660E\u767D\uFF0C\u6709\u4E9B\u544A\u522B\u4ECE\u6765\u6CA1\u6709\u771F\u6B63\u8BF4\u5B8C\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_003
    SourceText: "\u7B49\u8FD9\u76CF\u706F\u4EAE\u8D77\u6765\uFF0C\u6211\u4EEC\u5C31\u4E00\u8D77\u56DE\u53BB\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_004
    SourceText: "\u8FD9\u662F\u8BB8\u8001\u5E08\u53BB\u5E74\u8BF4\u7684\u8BDD\u3002\u90A3\u5929\u793E\u56E2\u7684\u544A\u522B\u5E7F\u64AD\u56E0\u4E3A\u505C\u7535\u4E2D\u65AD\uFF0C\u5979\u628A\u8282\u76EE\u5355\u5939\u8FDB\u4FE1\u5C01\uFF0C\u8BF4\u7B49\u5927\u5BB6\u51C6\u5907\u597D\uFF0C\u518D\u4E00\u8D77\u542C\u5B8C\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_005
    SourceText: "\u697C\u68AF\u95F4\u4F20\u6765\u8F7B\u8F7B\u7684\u811A\u6B65\u58F0\u3002\u5468\u781A\u63A8\u95E8\u8D70\u6765\uFF0C\u628A\u4E00\u53F0\u65E7\u5F55\u97F3\u673A\u653E\u5728\u680F\u6746\u65C1\u3002\u6797\u665A\u5411\u5DE6\u8BA9\u51FA\u4F4D\u7F6E\uFF0C\u4E24\u4E2A\u4EBA\u7EC8\u4E8E\u7AD9\u8FDB\u540C\u4E00\u7247\u665A\u971E\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_006
    SourceText: "\u7535\u6C60\u6362\u597D\u4E86\u3002\u4E0D\u8FC7\u6211\u53EA\u68C0\u67E5\u4E86\u5F00\u5173\uFF0C\u6CA1\u6709\u66FF\u4F60\u4EEC\u6309\u64AD\u653E\u3002\u8FD9\u91CC\u9762\u7684\u6700\u540E\u4E00\u6BB5\uFF0C\u5E94\u8BE5\u7531\u60F3\u542C\u7684\u4EBA\u51B3\u5B9A\u4EC0\u4E48\u65F6\u5019\u5F00\u59CB\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_007
    SourceText: "\u4F60\u8FD8\u662F\u8FD9\u4E48\u8BA4\u771F\u3002\u6211\u539F\u672C\u4EE5\u4E3A\uFF0C\u53EA\u8981\u627E\u5230\u5F55\u97F3\u673A\uFF0C\u628A\u6CA1\u64AD\u5B8C\u7684\u8BDD\u653E\u51FA\u6765\uFF0C\u8FD9\u4EF6\u4E8B\u5C31\u7B97\u5B8C\u6210\u4E86\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_008
    SourceText: "\u5B8C\u6210\u4E0D\u662F\u4FEE\u597D\u4E00\u4E2A\u5F00\u5173\u3002\u6211\u4EEC\u5F97\u5148\u77E5\u9053\uFF0C\u90A3\u4E2A\u4EBA\u73B0\u5728\u8FD8\u613F\u4E0D\u613F\u610F\u8BA9\u522B\u4EBA\u542C\u89C1\u3002\u4F60\u8054\u7CFB\u8FC7\u8BB8\u8001\u5E08\u4E86\u5417\uFF1F"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_009
    SourceText: "\u6797\u665A\u70B9\u4EAE\u624B\u673A\u3002\u5C4F\u5E55\u4E0A\u53EA\u6709\u4E00\u6761\u521A\u6536\u5230\u7684\u6D88\u606F\uFF1A\u201C\u6211\u8BB0\u5F97\u90A3\u6BB5\u5F55\u97F3\u3002\u4F60\u4EEC\u53EF\u4EE5\u542C\uFF0C\u4E5F\u53EF\u4EE5\u628A\u5B83\u7559\u5230\u4E0B\u6B21\u89C1\u9762\u3002\u4ECA\u665A\u4E0D\u5FC5\u66FF\u6211\u5B8C\u6210\u4EC0\u4E48\u3002\u201D"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_010
    SourceText: "\uFF08\u6211\u8BFB\u4E86\u4E24\u904D\u3002\u6CA1\u6709\u8D23\u602A\uFF0C\u4E5F\u6CA1\u6709\u50AC\u4FC3\u3002\u53EF\u6B63\u56E0\u4E3A\u6CA1\u6709\u4EBA\u50AC\uFF0C\u6211\u624D\u66F4\u6E05\u695A\u5730\u542C\u89C1\u81EA\u5DF1\u5FC3\u91CC\u90A3\u4E2A\u603B\u8BF4\u201C\u518D\u7B49\u4E00\u4E0B\u201D\u7684\u58F0\u97F3\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_011
    SourceText: "\u5979\u7ED9\u4E86\u6211\u4EEC\u9009\u62E9\uFF0C\u6211\u5374\u53CD\u800C\u4E0D\u6562\u9009\u4E86\u3002\u8981\u662F\u5F55\u97F3\u91CC\u53EA\u5269\u4E00\u53E5\u666E\u901A\u7684\u665A\u5B89\uFF0C\u6211\u4EEC\u7B49\u8FD9\u4E00\u5E74\uFF0C\u4F1A\u4E0D\u4F1A\u663E\u5F97\u5F88\u50BB\uFF1F"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_012
    SourceText: "\u666E\u901A\u4E5F\u53EF\u4EE5\u88AB\u8BA4\u771F\u5BF9\u5F85\u3002\u6211\u4EEC\u7B49\u7684\u53C8\u4E0D\u662F\u4E00\u4E2A\u8DB3\u591F\u7CBE\u5F69\u7684\u7ED3\u5C40\uFF0C\u53EA\u662F\u5F53\u65F6\u88AB\u6253\u65AD\u7684\u4E00\u53E5\u8BDD\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_013
    SourceText: "\u98CE\u4ECE\u6211\u4EEC\u4E4B\u95F4\u7A7F\u8FC7\u53BB\uFF0C\u628A\u4FE1\u5C01\u7FFB\u4E86\u4E2A\u9762\u3002\u4E00\u884C\u94C5\u7B14\u5B57\u9732\u51FA\u6765\uFF1A\u201C\u5982\u679C\u4F60\u8FD8\u6CA1\u51C6\u5907\u597D\u544A\u8BC9\u522B\u4EBA\u3002\u201D\u6797\u665A\u503E\u8EAB\u6309\u4F4F\u7FD8\u8D77\u7684\u7EB8\u89D2\uFF0C\u53C8\u6162\u6162\u6536\u56DE\u624B\uFF0C\u76EE\u5149\u505C\u5728\u90A3\u5C01\u59CB\u7EC8\u6CA1\u6709\u5BC4\u51FA\u7684\u56DE\u4FE1\u4E0A\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_014
    SourceText: "\uFF08\u90A3\u5E45\u753B\u7B54\u5E94\u7ED9\u670B\u53CB\u770B\uFF0C\u5374\u4E00\u76F4\u6CA1\u5BC4\u51FA\u53BB\u3002\u6211\u628A\u6BCF\u4E00\u6B21\u72B9\u8C6B\u53EB\u4F5C\u4FEE\u6539\uFF0C\u4EFF\u4F5B\u53EA\u8981\u8FD8\u5728\u4FEE\u6539\uFF0C\u5C31\u4E0D\u5FC5\u627F\u8BA4\u81EA\u5DF1\u5BB3\u6015\u88AB\u770B\u89C1\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_015
    SourceText: "\u4F60\u4E00\u76F4\u6CA1\u8BF4\u8BDD\u3002\u662F\u60F3\u8D77\u4EC0\u4E48\u4E86\u5417\uFF1F\u5982\u679C\u4E0D\u65B9\u4FBF\u8BB2\uFF0C\u53EF\u4EE5\u4E0D\u8BB2\u3002\u6211\u4EEC\u6765\u8FD9\u91CC\uFF0C\u4E0D\u662F\u8981\u8F6E\u6D41\u4EA4\u51FA\u81EA\u5DF1\u7684\u79D8\u5BC6\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_016
    SourceText: "\u6211\u4EEC\u53EF\u4EE5\u5B89\u9759\u4E00\u4F1A\u513F\u3002\u5929\u8FD8\u6CA1\u5168\u9ED1\uFF0C\u95E8\u4E5F\u4E0D\u4F1A\u7ACB\u523B\u9501\u4E0A\u3002\u505A\u51B3\u5B9A\u4E4B\u524D\u7684\u7A7A\u767D\uFF0C\u4E0D\u7B97\u6D6A\u8D39\u65F6\u95F4\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_017
    SourceText: "\u8C01\u90FD\u6CA1\u6709\u7EE7\u7EED\u8BF4\u8BDD\u3002\u6211\u628A\u76EE\u5149\u4ECE\u4E24\u4E2A\u4EBA\u8EAB\u4E0A\u79FB\u5F00\uFF0C\u671B\u5411\u697C\u4E0B\u3002\u8857\u53E3\u7684\u706F\u5F00\u59CB\u63A5\u8FDE\u4EAE\u8D77\uFF0C\u5148\u662F\u4E00\u76CF\uFF0C\u518D\u662F\u4E00\u6574\u6392\u5E97\u94FA\u3002\u57CE\u5E02\u7167\u5E38\u8FD0\u8F6C\uFF0C\u6CA1\u6709\u56E0\u4E3A\u67D0\u4E2A\u508D\u665A\u505C\u4E0B\u6765\uFF0C\u5374\u4E5F\u6CA1\u6709\u628A\u8C01\u4E22\u5728\u540E\u9762\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_018
    SourceText: "\uFF08\u6211\u7B2C\u4E00\u6B21\u8BD5\u7740\u4E0D\u66FF\u81EA\u5DF1\u8FA9\u89E3\u3002\u4E5F\u8BB8\u90A3\u5E45\u753B\u4E0D\u9700\u8981\u518D\u597D\u4E00\u70B9\uFF0C\u53EA\u9700\u8981\u4E00\u53E5\u8BDA\u5B9E\u7684\u8BDD\uFF1A\u8FD9\u662F\u5F53\u65F6\u7684\u6211\uFF0C\u753B\u5F97\u4E0D\u591F\u597D\uFF0C\u4F46\u6211\u8FD8\u8BB0\u5F97\u4F60\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_019
    SourceText: "\u7247\u523B\u540E\uFF0C\u6797\u665A\u4ECE\u680F\u6746\u8FB9\u8D70\u56DE\u6765\uFF0C\u5C06\u4FE1\u5C01\u5728\u6211\u4EEC\u9762\u524D\u644A\u5E73\u3002\u5468\u781A\u628A\u5F55\u97F3\u673A\u8F6C\u5411\u6211\u3002\u90A3\u9897\u5C0F\u5C0F\u7684\u64AD\u653E\u952E\u8FD8\u6CA1\u6709\u88AB\u6309\u4E0B\uFF0C\u6211\u5374\u89C9\u5F97\uFF0C\u81EA\u5DF1\u7684\u51B3\u5B9A\u5DF2\u7ECF\u6CA1\u6709\u521A\u624D\u90A3\u4E48\u91CD\u4E86\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_020
    SourceText: "\u5982\u679C\u73B0\u5728\u542C\uFF0C\u6211\u60F3\u628A\u5B83\u5F53\u4F5C\u91CD\u65B0\u5F00\u59CB\uFF0C\u800C\u4E0D\u662F\u8BC1\u660E\u8FC7\u53BB\u6CA1\u6709\u767D\u7B49\u3002\u5982\u679C\u4E0D\u542C\uFF0C\u6211\u4E5F\u60F3\u8BA4\u771F\u5730\u628A\u4FE1\u5BC4\u51FA\u53BB\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_021
    SourceText: "\u90A3\u5C31\u9009\u4F60\u771F\u6B63\u60F3\u505A\u7684\u3002\u542C\u5B8C\u4EE5\u540E\u4ECD\u7136\u53EF\u4EE5\u5199\u4FE1\uFF0C\u5199\u5B8C\u4EE5\u540E\u4E5F\u53EF\u4EE5\u518D\u89C1\u9762\u3002\u6211\u4EEC\u9009\u7684\u662F\u4ECA\u665A\u5148\u8FC8\u51FA\u7684\u90A3\u4E00\u6B65\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_022
    SourceText: "\u8BB8\u8001\u5E08\u53C8\u53D1\u6765\u4E00\u5F20\u7167\u7247\u3002\u7167\u7247\u91CC\u7684\u8584\u8377\u76C6\u683D\u6B6A\u5411\u7A97\u8FB9\uFF0C\u914D\u6587\u662F\u201C\u660E\u5929\u8BB0\u5F97\u6D47\u6C34\u201D\u3002\u6797\u665A\u7B11\u8D77\u6765\uFF0C\u539F\u6765\u8BA4\u771F\u544A\u522B\u7684\u4EBA\uFF0C\u4E5F\u4F1A\u5FD8\u8BB0\u7167\u987E\u81EA\u5DF1\u7684\u690D\u7269\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_023
    SourceText: "\uFF08\u6211\u628A\u670B\u53CB\u7684\u804A\u5929\u7A97\u53E3\u6253\u5F00\uFF0C\u53C8\u6682\u65F6\u5408\u4E0A\u3002\u5148\u628A\u773C\u524D\u8FD9\u4EF6\u4E8B\u505A\u5B8C\u3002\u4E0D\u662F\u6C38\u8FDC\u7B49\u4E0B\u53BB\uFF0C\u53EA\u662F\u7ED9\u4ECA\u665A\u4E00\u4E2A\u6E05\u695A\u3001\u80FD\u591F\u8BB0\u4F4F\u7684\u987A\u5E8F\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_024
    SourceText: "{playerName}\uFF0C\u6211\u51C6\u5907\u597D\u4E86\u3002\u65E0\u8BBA\u4F60\u9009\u54EA\u4E00\u79CD\uFF0C\u6211\u90FD\u7559\u5728\u8FD9\u91CC\u3002\u7B49\u6700\u540E\u90A3\u76CF\u706F\u4EAE\u8D77\u6765\uFF0C\u6211\u4EEC\u4E00\u8D77\u4E0B\u697C\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_intro_025
    SourceText: "\u5F55\u97F3\u673A\u548C\u4FE1\u7EB8\u5E76\u6392\u653E\u5728\u680F\u6746\u4E0A\u3002\u4F60\u53EF\u4EE5\u73B0\u5728\u64AD\u653E\u6700\u540E\u4E00\u6BB5\u5F55\u97F3\uFF0C\u4E5F\u53EF\u4EE5\u5148\u5199\u4E00\u5C01\u56DE\u4FE1\uFF0C\u628A\u503E\u542C\u7559\u5230\u771F\u6B63\u89C1\u9762\u7684\u90A3\u4E00\u5929\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_001
    SourceText: "\u5915\u9633\u7EC8\u4E8E\u9000\u5230\u697C\u7FA4\u540E\u9762\u3002\u5929\u53F0\u4ECD\u662F\u6765\u65F6\u7684\u5929\u53F0\uFF0C\u680F\u6746\u4E0A\u7684\u6C34\u5DF2\u7ECF\u5E72\u4E86\u3002\u4F60\u4EEC\u628A\u7EB8\u5F20\u548C\u7535\u6C60\u6536\u597D\uFF0C\u53EA\u7559\u6700\u540E\u4E00\u76CF\u95E8\u706F\u7167\u7740\u53F0\u9636\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_002
    SourceText: "\u521A\u624D\u6211\u4E00\u76F4\u5728\u60F3\uFF0C\u4EC0\u4E48\u65F6\u5019\u624D\u7B97\u544A\u522B\u5B8C\u6210\u3002\u73B0\u5728\u53C8\u89C9\u5F97\uFF0C\u4E5F\u8BB8\u4E0D\u7528\u7ED9\u5B83\u76D6\u4E00\u4E2A\u7AE0\u3002\u80FD\u628A\u60F3\u8BF4\u7684\u8BDD\u8BA4\u771F\u8BF4\u4E00\u6B21\uFF0C\u5C31\u5DF2\u7ECF\u5F88\u597D\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_003
    SourceText: "\uFF08\u6211\u770B\u7740\u5979\u3002\u4E00\u4E2A\u508D\u665A\u6CA1\u6709\u6539\u53D8\u6240\u6709\u4E8B\u60C5\uFF0C\u6CA1\u5BC4\u51FA\u7684\u753B\u4E5F\u4E0D\u4F1A\u56E0\u6B64\u53D8\u5F97\u66F4\u6F02\u4EAE\u3002\u4F46\u6211\u613F\u610F\u8BA9\u522B\u4EBA\u770B\u89C1\u5B83\u4E86\uFF0C\u8FD9\u4E00\u70B9\u662F\u771F\u7684\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_004
    SourceText: "\u4F60\u542C\u89C1\u697C\u4E0B\u7684\u8F66\u58F0\u4E86\u5417\uFF1F\u521A\u6765\u7684\u65F6\u5019\u6211\u89C9\u5F97\u5B83\u4EEC\u597D\u5435\u3002\u73B0\u5728\u5012\u89C9\u5F97\uFF0C\u8FD9\u4E9B\u666E\u901A\u7684\u58F0\u97F3\u8BA9\u4EBA\u653E\u5FC3\uFF0C\u4E16\u754C\u8FD8\u5728\u7B49\u6211\u4EEC\u56DE\u53BB\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_005
    SourceText: "\u5468\u781A\u63D0\u8D77\u76D2\u5B50\uFF0C\u8D70\u5230\u95E8\u8FB9\uFF0C\u53C8\u8F6C\u8EAB\u7B49\u4F60\u4EEC\u3002\u6797\u665A\u628A\u6700\u540E\u4E00\u5F20\u4FE1\u7EB8\u6536\u8FDB\u53E3\u888B\u3002\u4E24\u4E2A\u4EBA\u4E00\u5DE6\u4E00\u53F3\uFF0C\u7ED9\u4F60\u7559\u51FA\u8D70\u5411\u697C\u68AF\u7684\u7A7A\u9699\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_006
    SourceText: "\u95E8\u6211\u6765\u5173\u3002\u5148\u68C0\u67E5\u4E00\u4E0B\u6709\u6CA1\u6709\u843D\u4E1C\u897F\uFF0C\u5C24\u5176\u662F\u90A3\u652F\u4E00\u8DEF\u501F\u6765\u501F\u53BB\u7684\u7B14\u3002\u91CD\u8981\u7684\u544A\u522B\uFF0C\u4E5F\u4E0D\u80FD\u6210\u4E3A\u4E22\u4E1C\u897F\u7684\u7406\u7531\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_007
    SourceText: "\u5728\u6211\u8FD9\u91CC\u3002\u660E\u5929\u8FD8\u4F60\uFF0C\u4E0D\uFF0C\u7B49\u4E00\u4E0B\uFF0C\u73B0\u5728\u5C31\u8FD8\u3002\u6211\u4EEC\u4ECA\u665A\u4E0D\u662F\u521A\u5B66\u4F1A\u522B\u628A\u6BCF\u4EF6\u5C0F\u4E8B\u90FD\u63A8\u5230\u660E\u5929\u5417\uFF1F"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_008
    SourceText: "\u4E09\u4E2A\u4EBA\u7B11\u8D77\u6765\u3002\u7B49\u5F85\u3001\u9057\u61BE\u3001\u7ED3\u5C3E\uFF0C\u8FD9\u4E9B\u521A\u624D\u8FD8\u5F88\u6C89\u7684\u8BCD\uFF0C\u5FFD\u7136\u53EF\u4EE5\u548C\u4E00\u652F\u627E\u56DE\u6765\u7684\u7B14\u3001\u4E00\u6BB5\u4E0B\u697C\u7684\u8DEF\u653E\u5728\u540C\u4E00\u4E2A\u53E3\u888B\u91CC\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_009
    SourceText: "\uFF08\u6211\u6CA1\u6709\u7ACB\u523B\u62FF\u51FA\u624B\u673A\u786E\u8BA4\u56DE\u590D\u3002\u7B2C\u4E00\u6B21\uFF0C\u6C89\u9ED8\u6CA1\u6709\u50AC\u4FC3\u6211\u7F16\u51FA\u4E00\u4E2A\u574F\u7684\u7B54\u6848\u3002\u6211\u77E5\u9053\u6D88\u606F\u5DF2\u7ECF\u53D1\u51FA\uFF0C\u4E5F\u77E5\u9053\u81EA\u5DF1\u4ECD\u7136\u53EF\u4EE5\u7EE7\u7EED\u5F80\u524D\u8D70\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_010
    SourceText: "\u7ED9\u4ECA\u665A\u8D77\u4E2A\u540D\u5B57\u5427\u3002\u4EE5\u540E\u8BF4\u8D77\u6765\uFF0C\u4E0D\u7528\u6BCF\u6B21\u90FD\u4ECE\u90A3\u5F20\u8282\u76EE\u5355\u8BB2\u8D77\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_011
    SourceText: "\u5C31\u53EB\u201C\u6700\u540E\u4E00\u76CF\u706F\u201D\u3002\u4E0D\u662F\u6C38\u8FDC\u4E0D\u4F1A\u7184\u706D\u7684\u706F\uFF0C\u662F\u6709\u4EBA\u5173\u597D\u95E8\u4EE5\u540E\uFF0C\u613F\u610F\u548C\u4F60\u4E00\u8D77\u5F80\u524D\u8D70\u7684\u90A3\u4E00\u76CF\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_012
    SourceText: "\u6211\u4EEC\u4E00\u8D77\u5FF5\u4E86\u4E00\u904D\u8FD9\u4E2A\u540D\u5B57\u3002\u5468\u781A\u63D0\u8D77\u76D2\u5B50\uFF0C\u5148\u4FA7\u8EAB\u62C9\u5F00\u95E8\uFF1B\u6797\u665A\u6309\u4F4F\u88AB\u98CE\u5439\u8D77\u7684\u7EB8\u9875\uFF0C\u8DDF\u7740\u4ED6\u8D70\u4E0B\u53F0\u9636\u3002\u697C\u68AF\u95F4\u7684\u5149\u7167\u4EAE\u4E24\u4EBA\u7684\u5F71\u5B50\uFF0C\u53C8\u968F\u7740\u811A\u6B65\u4E00\u70B9\u70B9\u9000\u51FA\u5929\u53F0\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_013
    SourceText: "\uFF08\u4E0B\u4E00\u6B21\u89C1\u9762\u65F6\uFF0C\u6211\u4E5F\u8BB8\u8FD8\u4F1A\u7D27\u5F20\uFF0C\u8BDD\u4E5F\u672A\u5FC5\u8BF4\u5F97\u66F4\u6F02\u4EAE\u3002\u4F46\u6211\u4E0D\u5FC5\u628A\u81EA\u5DF1\u53D8\u6210\u53E6\u4E00\u4E2A\u4EBA\uFF0C\u624D\u6709\u8D44\u683C\u6309\u4E0B\u64AD\u653E\uFF0C\u6216\u8005\u5BC4\u51FA\u4E00\u5C01\u4FE1\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_common_014
    SourceText: "\u95E8\u8F7B\u8F7B\u5408\u4E0A\u3002\u7A7A\u4E0B\u6765\u7684\u5929\u53F0\u53EA\u5269\u665A\u98CE\uFF0C\u7A97\u706F\u5012\u6620\u5728\u6C34\u8FF9\u91CC\u3002\u4ECA\u665A\u7684\u6545\u4E8B\u5728\u8FD9\u91CC\u505C\u4E0B\uFF0C\u660E\u5929\u7684\u90A3\u4E00\u9875\uFF0C\u4ECD\u7559\u7740\u53EF\u4EE5\u7EE7\u7EED\u4E66\u5199\u7684\u4F4D\u7F6E\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_001
    SourceText: "\u90A3\u6211\u4EEC\u5148\u5199\u4FE1\u3002\u7B49\u4E0B\u6B21\u89C1\u5230\u5979\uFF0C\u518D\u5F53\u9762\u95EE\u4E00\u53E5\uFF1A\u73B0\u5728\u53EF\u4EE5\u4E00\u8D77\u542C\u5417\uFF1F\u6211\u4E0D\u60F3\u628A\u8FD9\u6B21\u6682\u7F13\uFF0C\u5199\u6210\u53C8\u4E00\u6B21\u6CA1\u6709\u4E0B\u6587\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_002
    SourceText: "\u5468\u781A\u5173\u6389\u5F55\u97F3\u673A\uFF0C\u5C06\u5B83\u653E\u56DE\u76D2\u5B50\u91CC\u3002\u6797\u665A\u4FA7\u8EAB\u8BA9\u51FA\u4F4D\u7F6E\uFF0C\u4ED6\u62B1\u7740\u76D2\u5B50\u7ED5\u5230\u5DE6\u8FB9\uFF1B\u5979\u6CBF\u7740\u77EE\u5899\u8D70\u5230\u53F3\u4FA7\uFF0C\u628A\u7EB8\u94FA\u5E73\u3002\u4E24\u4EBA\u6362\u4E86\u4E2A\u4F4D\u7F6E\uFF0C\u4E3A\u6211\u7559\u51FA\u4E2D\u95F4\u90A3\u4E00\u5C0F\u5757\u53EF\u4EE5\u843D\u7B14\u7684\u5730\u65B9\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_003
    SourceText: "\u522B\u5199\u201C\u7B49\u6211\u4EEC\u5168\u90E8\u51C6\u5907\u597D\u201D\u3002\u90A3\u53E5\u8BDD\u592A\u5927\u4E86\u3002\u6211\u5EFA\u8BAE\u5199\u4E00\u4E2A\u786E\u5207\u7684\u65E5\u5B50\uFF0C\u518D\u7ED9\u5BF9\u65B9\u4E00\u4E2A\u53EF\u4EE5\u62D2\u7EDD\u6216\u6539\u671F\u7684\u4F59\u5730\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_004
    SourceText: "\uFF08\u6211\u63E1\u7740\u7B14\uFF0C\u5148\u5199\u4E86\u201C\u5BF9\u4E0D\u8D77\u201D\uFF0C\u53C8\u505C\u4F4F\u3002\u4E5F\u8BB8\u8FD9\u5C01\u4FE1\u4E0D\u9700\u8981\u4ECE\u9053\u6B49\u5F00\u59CB\u3002\u6211\u4EEC\u53EF\u4EE5\u5148\u544A\u8BC9\u5979\uFF0C\u4FE1\u5DF2\u7ECF\u88AB\u770B\u89C1\uFF0C\u4EBA\u4E5F\u90FD\u5E73\u5B89\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_005
    SourceText: "\u4F60\u5199\uFF1A\u201C\u8BB8\u8001\u5E08\uFF0C\u4ECA\u5929\u6211\u4EEC\u5728\u5929\u53F0\u627E\u5230\u4E86\u6700\u540E\u4E00\u5F20\u8282\u76EE\u5355\u3002\u96E8\u505C\u4E86\uFF0C\u65E7\u697C\u7684\u706F\u5F88\u597D\u770B\u3002\u6211\u4EEC\u60F3\u9080\u8BF7\u60A8\u4E0B\u5468\u516D\u56DE\u6765\u5750\u4E00\u4F1A\u513F\u3002\u201D"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_006
    SourceText: "\u540E\u9762\u518D\u52A0\u4E00\u53E5\uFF0C\u5982\u679C\u4E0D\u65B9\u4FBF\uFF0C\u56DE\u4E00\u5F20\u8584\u8377\u7684\u7167\u7247\u4E5F\u53EF\u4EE5\u3002\u5979\u770B\u5230\u80AF\u5B9A\u4F1A\u7B11\uFF0C\u8BF4\u6211\u4EEC\u7EC8\u4E8E\u5B66\u4F1A\u7ED9\u6D3B\u52A8\u7559\u5907\u7528\u65B9\u6848\u4E86\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_007
    SourceText: "\u4E5F\u5199\u6E05\u695A\uFF0C\u4E0D\u7528\u5E26\u65B0\u7684\u8282\u76EE\u7A3F\u3002\u6211\u4EEC\u4E0D\u662F\u8BF7\u5979\u8865\u4EA4\u4E00\u4EFD\u4F5C\u4E1A\uFF0C\u53EA\u662F\u60F3\u89C1\u9762\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_008
    SourceText: "\u5468\u781A\u4FEF\u8EAB\u51D1\u8FC7\u6765\uFF0C\u5728\u7EB8\u89D2\u6DFB\u4E0A\u4E00\u884C\u5B57\u3002\u6797\u665A\u4F38\u624B\u66FF\u4ED6\u538B\u4F4F\u88AB\u98CE\u6380\u8D77\u7684\u7EB8\u8FB9\uFF0C\u4ED6\u4FBF\u9000\u5230\u5979\u8EAB\u540E\uFF0C\u8BA9\u51FA\u5149\u7EBF\u3002\u4E09\u79CD\u4E0D\u540C\u7684\u7B14\u8FF9\u6324\u5728\u4E00\u8D77\uFF0C\u6709\u4E00\u7B14\u5199\u6B6A\u4E86\uFF0C\u8FD8\u6709\u4E00\u5904\u6CA1\u64E6\u5E72\u7684\u6C34\u5370\uFF0C\u4E0D\u591F\u6574\u9F50\uFF0C\u5374\u5F88\u50CF\u6211\u4EEC\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_009
    SourceText: "\uFF08\u6211\u7A81\u7136\u4E0D\u60F3\u91CD\u65B0\u6284\u4E00\u904D\u3002\u90A3\u4E9B\u4E0D\u6574\u9F50\u7684\u5730\u65B9\uFF0C\u6B63\u597D\u8BF4\u660E\u5199\u4FE1\u7684\u65F6\u5019\uFF0C\u98CE\u5728\u5439\uFF0C\u4EBA\u4E5F\u90FD\u771F\u7684\u5728\u8FD9\u91CC\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_010
    SourceText: "\u6211\u539F\u6765\u4EE5\u4E3A\uFF0C\u4ECA\u665A\u4E0D\u542C\u5C31\u662F\u9000\u7F29\u3002\u73B0\u5728\u53D1\u73B0\uFF0C\u628A\u201C\u4EE5\u540E\u201D\u5199\u6210\u4E0B\u5468\u516D\uFF0C\u4E5F\u9700\u8981\u4E00\u70B9\u52C7\u6C14\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_011
    SourceText: "\u8FD8\u9700\u8981\u8BB0\u5F97\u6309\u65F6\u53BB\u3002\u7B54\u5E94\u4E4B\u524D\u60F3\u6E05\u695A\uFF0C\u7B54\u5E94\u4EE5\u540E\u7559\u51FA\u65F6\u95F4\uFF0C\u6BD4\u8BF4\u4E00\u53E5\u597D\u542C\u7684\u8BDD\u9EBB\u70E6\u5F97\u591A\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_012
    SourceText: "\u4F60\u4EEC\u628A\u4FE1\u62CD\u6210\u7167\u7247\uFF0C\u53D1\u7ED9\u8BB8\u8001\u5E08\u3002\u7EB8\u8D28\u539F\u4EF6\u4ECD\u88C5\u56DE\u4FE1\u5C01\uFF0C\u51C6\u5907\u4E0B\u6B21\u4EB2\u624B\u4EA4\u7ED9\u5979\u3002\u5F55\u97F3\u5B89\u9759\u5730\u7559\u5728\u76D2\u5B50\u91CC\uFF0C\u4E0D\u518D\u50CF\u4E00\u4EF6\u5FC5\u987B\u7ACB\u523B\u89E3\u51B3\u7684\u4E8B\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_013
    SourceText: "\u8001\u5E08\u56DE\u590D\u4E86\uFF1A\u201C\u4E0B\u5468\u4E09\u53EF\u4EE5\u3002\u6211\u5E26\u8336\u5427\uFF0C\u4F60\u4EEC\u522B\u5E26\u592A\u591A\u4E1C\u897F\u3002\u201D\u5468\u781A\u4F4E\u5934\u770B\u5B8C\uFF0C\u8F7B\u8F7B\u70B9\u4E86\u70B9\u5934\u3002\u90A3\u53E5\u8BDD\u628A\u6211\u4EEC\u7B49\u4E86\u5F88\u4E45\u7684\u4E8B\uFF0C\u653E\u56DE\u4E00\u4E2A\u53EF\u4EE5\u6162\u6162\u5546\u91CF\u7684\u4F4D\u7F6E\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_014
    SourceText: "\uFF08\u6211\u4E5F\u7ED9\u670B\u53CB\u53D1\u53BB\u6D88\u606F\uFF1A\u90A3\u5E45\u753B\u8FD8\u5728\uFF0C\u4F60\u4E0B\u5468\u6709\u7A7A\u5417\uFF1F\u8FD9\u4E00\u6B21\uFF0C\u6211\u6CA1\u6709\u7528\u4E00\u4E2A\u542B\u7CCA\u7684\u201C\u6709\u673A\u4F1A\u201D\uFF0C\u628A\u8BDD\u63A8\u5230\u8C01\u4E5F\u627E\u4E0D\u5230\u7684\u5730\u65B9\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_015
    SourceText: "\u4F60\u7684\u4FE1\u4E5F\u53D1\u51FA\u53BB\u4E86\uFF1F\u90A3\u4ECA\u665A\u7684\u90AE\u5C40\u53EF\u4EE5\u4E0B\u73ED\u4E86\u3002\u5269\u4E0B\u7684\u4E8B\uFF0C\u6211\u4EEC\u5404\u81EA\u8BB0\u5728\u65E5\u5386\u4E0A\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_016
    SourceText: "\u4F60\u5728\u624B\u673A\u91CC\u8BB0\u4E0B\u65F6\u95F4\u3002\u5C0F\u5C0F\u7684\u65B9\u683C\u5BB9\u4E0D\u4E0B\u6240\u6709\u590D\u6742\u5FC3\u60C5\uFF0C\u5374\u5BB9\u5F97\u4E0B\u4E00\u4E2A\u5730\u70B9\u3001\u4E00\u4E2A\u65E5\u671F\u548C\u4E00\u53E5\u201C\u522B\u5FD8\u4E86\u5E26\u753B\u201D\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_017
    SourceText: "\u6211\u77E5\u9053\u660E\u5929\u53EF\u80FD\u8FD8\u4F1A\u72B9\u8C6B\u3002\u4F46\u81F3\u5C11\u5230\u65F6\u5019\uFF0C\u6211\u53EF\u4EE5\u56DE\u6765\u770B\u770B\u4ECA\u665A\u5199\u4E0B\u7684\u5B57\uFF0C\u63D0\u9192\u81EA\u5DF1\u8FD9\u4E0D\u662F\u4E00\u65F6\u968F\u53E3\u8BF4\u8BF4\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_018
    SourceText: "\u72B9\u8C6B\u7684\u65F6\u5019\u53EF\u4EE5\u518D\u5546\u91CF\u3002\u505A\u4E86\u9009\u62E9\uFF0C\u4E5F\u4E0D\u4EE3\u8868\u4ECE\u6B64\u53EA\u80FD\u4E00\u4E2A\u4EBA\u6491\u7740\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_019
    SourceText: "\u6CA1\u6709\u54CD\u8D77\u7684\u5F55\u97F3\u6CA1\u6709\u6D88\u5931\u3002\u5B83\u548C\u6298\u597D\u7684\u4FE1\u4E00\u8D77\uFF0C\u88AB\u4F60\u4EEC\u59A5\u5584\u653E\u8FDB\u76D2\u5B50\u3002\u4F60\u5FFD\u7136\u61C2\u5F97\uFF0C\u6682\u65F6\u505C\u4E0B\u548C\u6084\u6084\u653E\u5F03\uFF0C\u539F\u6765\u53EF\u4EE5\u6709\u5B8C\u5168\u4E0D\u540C\u7684\u6837\u5B50\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_letter_020
    SourceText: "\u6797\u665A\u5C06\u76D2\u5B50\u62B1\u7D27\uFF0C\u5468\u781A\u8BB0\u4E0B\u4E0B\u6B21\u89C1\u9762\u7684\u65F6\u95F4\u3002\u4F60\u4EEC\u6CA1\u6709\u8865\u4E0A\u8FC7\u53BB\u7684\u5168\u90E8\u7A7A\u767D\uFF0C\u53EA\u7ED9\u660E\u5929\u7559\u4E0B\u4E86\u4E00\u4EF6\u80FD\u591F\u771F\u6B63\u53BB\u505A\u7684\u5C0F\u4E8B\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_001
    SourceText: "\u90A3\u5C31\u73B0\u5728\u542C\u5427\u3002\u4E0D\u662F\u628A\u8FD9\u4E00\u5E74\u8FFD\u56DE\u6765\uFF0C\u53EA\u662F\u8BA9\u6211\u4EEC\u7EC8\u4E8E\u77E5\u9053\uFF0C\u505C\u7535\u4E4B\u540E\uFF0C\u5979\u539F\u672C\u8FD8\u60F3\u8BF4\u4EC0\u4E48\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_002
    SourceText: "\u5468\u781A\u6309\u4E0B\u64AD\u653E\u952E\u3002\u77ED\u4FC3\u7684\u63D0\u793A\u97F3\u8FC7\u540E\uFF0C\u5148\u54CD\u8D77\u4E00\u6BB5\u7A7A\u767D\u3002\u4F60\u51E0\u4E4E\u4EE5\u4E3A\u5F55\u97F3\u635F\u574F\u4E86\uFF0C\u968F\u540E\u624D\u542C\u89C1\u5F88\u8F7B\u7684\u547C\u5438\u548C\u7FFB\u52A8\u7EB8\u5F20\u7684\u58F0\u97F3\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_003
    SourceText: "\u5F00\u5934\u7559\u4E86\u51E0\u79D2\u7A7A\u767D\u3002\u6211\u4EE5\u524D\u603B\u60F3\u628A\u5B83\u526A\u6389\uFF0C\u73B0\u5728\u5374\u89C9\u5F97\uFF0C\u8FD9\u51E0\u79D2\u8BA9\u4EBA\u77E5\u9053\uFF0C\u5979\u4E5F\u662F\u60F3\u4E86\u5F88\u4E45\u624D\u5F00\u53E3\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_004
    SourceText: "\uFF08\u539F\u6765\u53EA\u6709\u4E00\u53E5\u8BDD\u8981\u8BF4\u7684\u65F6\u5019\uFF0C\u4E5F\u53EF\u4EE5\u5148\u6C89\u9ED8\u3002\u5F55\u97F3\u6CA1\u6709\u56E0\u4E3A\u8FD9\u6BB5\u7A7A\u767D\u5931\u53BB\u610F\u4E49\uFF0C\u6211\u90A3\u4E9B\u7B28\u62D9\u7684\u5F00\u5934\uFF0C\u4E5F\u4E0D\u5FC5\u5168\u90E8\u64E6\u6389\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_005
    SourceText: "\u5F55\u97F3\u91CC\u7684\u8001\u5E08\u6CA1\u6709\u53D1\u8868\u957F\u7BC7\u544A\u522B\u3002\u5979\u611F\u8C22\u503C\u73ED\u540C\u5B66\u5173\u597D\u95E8\u7A97\uFF0C\u63D0\u9192\u5927\u5BB6\u5E26\u8D70\u96E8\u4F1E\uFF0C\u53C8\u8BF4\u5982\u679C\u660E\u5929\u8FD8\u4E0B\u96E8\uFF0C\u8282\u76EE\u53EF\u4EE5\u665A\u4E00\u70B9\u518D\u64AD\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_006
    SourceText: "\u6211\u8BB0\u5F97\u5979\u90A3\u5929\u4E00\u76F4\u5728\u7B11\u3002\u6211\u4EE5\u4E3A\u5979\u4E00\u70B9\u4E5F\u4E0D\u7D27\u5F20\uFF0C\u539F\u6765\u7A3F\u7EB8\u7FFB\u4E86\u90A3\u4E48\u591A\u6B21\u3002\u90A3\u65F6\u5019\u6211\u4EEC\u7AD9\u5F97\u5F88\u8FD1\uFF0C\u5374\u6CA1\u6709\u8BA4\u771F\u542C\u8FC7\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_007
    SourceText: "\u5728\u73B0\u573A\u7684\u4EBA\u4E5F\u4F1A\u9519\u8FC7\u5F88\u591A\u4E1C\u897F\u3002\u73B0\u5728\u542C\u89C1\uFF0C\u5E76\u4E0D\u610F\u5473\u7740\u90A3\u65F6\u7684\u6211\u4EEC\u505A\u9519\u4E86\u4EC0\u4E48\u3002\u90A3\u5929\u5927\u5BB6\u90FD\u5728\u5FD9\u7740\u63A5\u4F4F\u773C\u524D\u7684\u96E8\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_008
    SourceText: "\u4F60\u60F3\u5230\u81EA\u5DF1\u66FE\u7ECF\u7B49\u8FC7\u4E00\u4E2A\u5F88\u957F\u7684\u89E3\u91CA\uFF0C\u540E\u6765\u8FDE\u7B49\u7684\u662F\u4EC0\u4E48\u90FD\u6A21\u7CCA\u4E86\u3002\u53EF\u8FD9\u6BB5\u5F55\u97F3\u6CA1\u6709\u89E3\u91CA\u6240\u6709\u4E8B\u60C5\uFF0C\u53EA\u628A\u4E00\u4E2A\u666E\u901A\u4E0B\u5348\uFF0C\u5B8C\u6574\u5730\u4EA4\u8FD8\u7ED9\u4F60\u4EEC\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_009
    SourceText: "\u5979\u8BF4\uFF0C\u6CA1\u80FD\u5B8C\u6210\u7684\u8282\u76EE\u4E0D\u5FC5\u8865\u6210\u5B8C\u7F8E\u7248\u672C\u3002\u613F\u610F\u518D\u6765\u7684\u4EBA\uFF0C\u4E0B\u6B21\u89C1\uFF1B\u5DF2\u7ECF\u5F80\u524D\u8D70\u7684\u4EBA\uFF0C\u4E5F\u4E0D\u7528\u4E3A\u6CA1\u56DE\u5934\u9053\u6B49\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_010
    SourceText: "\uFF08\u6211\u4E00\u76F4\u4EE5\u4E3A\uFF0C\u6709\u56DE\u5E94\u624D\u7B97\u8D70\u5B8C\u4E00\u6BB5\u8DEF\u3002\u539F\u6765\u6709\u4EBA\u613F\u610F\u8BF4\u201C\u4F60\u53EF\u4EE5\u7EE7\u7EED\u8D70\u201D\uFF0C\u4E5F\u5DF2\u7ECF\u662F\u4E00\u79CD\u56DE\u5E94\u3002\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_011
    SourceText: "\u6700\u540E\u8FD8\u6709\u4E00\u53E5\u3002\u522B\u6025\u7740\u5173\uFF0C\u542C\u5B8C\u518D\u8BF4\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_012
    SourceText: "\u4F60\u4EEC\u5C4F\u4F4F\u547C\u5438\u3002\u8FDC\u5904\u8F66\u8F86\u9A76\u8FC7\uFF0C\u98CE\u628A\u6742\u97F3\u5439\u5F97\u5F88\u8584\u3002\u5F55\u97F3\u5728\u4E00\u53E5\u8F7B\u8F7B\u7684\u201C\u665A\u5B89\u201D\u4E4B\u540E\u505C\u4E0B\uFF0C\u673A\u5668\u4ECD\u7136\u4EAE\u7740\uFF0C\u50CF\u662F\u5728\u7B49\u4E00\u4E2A\u4E0D\u5FC5\u8BF4\u51FA\u53E3\u7684\u56DE\u7B54\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_013
    SourceText: "\u665A\u5B89\uFF0C\u8BB8\u8001\u5E08\u3002\u8FDF\u4E86\u4E00\u5E74\uFF0C\u4E5F\u8FD8\u662F\u60F3\u8BF4\u7ED9\u4F60\u542C\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_014
    SourceText: "\u6211\u628A\u4ECA\u5929\u7684\u65E5\u671F\u5199\u5728\u6807\u7B7E\u80CC\u9762\u5427\u3002\u4E0D\u8986\u76D6\u539F\u6765\u7684\u65E5\u671F\uFF0C\u8FD9\u4E24\u5929\u90FD\u503C\u5F97\u7559\u4E0B\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_015
    SourceText: "\u6797\u665A\u62FF\u51FA\u7B14\uFF0C\u5728\u65E7\u6807\u7B7E\u65C1\u8FB9\u8865\u4E0A\u4E00\u884C\u5C0F\u5B57\u3002\u6CA1\u6709\u4EBA\u6495\u6389\u53D1\u9EC4\u7684\u90E8\u5206\uFF0C\u4E5F\u6CA1\u6709\u4EBA\u628A\u4E2D\u95F4\u7684\u7A7A\u767D\u6D82\u6EE1\u3002\u8FC7\u53BB\u548C\u4ECA\u665A\uFF0C\u7EC8\u4E8E\u53EF\u4EE5\u653E\u5728\u540C\u4E00\u4E2A\u76D2\u5B50\u91CC\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_016
    SourceText: "\uFF08\u6211\u628A\u90A3\u5E45\u65E7\u753B\u62CD\u4E0B\u6765\u3002\u8FD9\u4E00\u6B21\uFF0C\u6211\u6CA1\u6709\u8C03\u6574\u5230\u770B\u4E0D\u51FA\u7B14\u89E6\uFF0C\u4E5F\u6CA1\u6709\u89E3\u91CA\u4E3A\u4EC0\u4E48\u753B\u5F97\u4E0D\u597D\u3002\u6211\u53EA\u95EE\uFF1A\u4F60\u73B0\u5728\u65B9\u4FBF\u770B\u4E00\u5F20\u4EE5\u524D\u7684\u753B\u5417\uFF1F\uFF09"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_017
    SourceText: "\u53D1\u51FA\u53BB\u4E86\uFF1F\u4E0D\u7528\u7ED9\u6211\u4EEC\u770B\u3002\u770B\u4F60\u7684\u8868\u60C5\uFF0C\u6211\u5C31\u77E5\u9053\u6709\u4E00\u4EF6\u4E8B\u5DF2\u7ECF\u8D70\u5230\u4E86\u4E0B\u4E00\u6B65\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_018
    SourceText: "\u63A5\u4E0B\u6765\u5C31\u8F6E\u5230\u7B49\u5F85\u4E86\u3002\u4E0D\u8FC7\u8FD9\u4E00\u6B21\uFF0C\u7B49\u5F85\u7684\u524D\u9762\u6709\u4E00\u4E2A\u4F60\u81EA\u5DF1\u6309\u4E0B\u7684\u53D1\u9001\u952E\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_019
    SourceText: "\u624B\u673A\u6682\u65F6\u6CA1\u6709\u56DE\u5E94\u3002\u4F60\u628A\u5B83\u653E\u8FDB\u53E3\u888B\uFF0C\u542C\u89C1\u5F55\u97F3\u673A\u505C\u6B62\u8F6C\u52A8\u3002\u4ECA\u665A\u6CA1\u6709\u7A81\u7136\u53D8\u5F97\u5706\u6EE1\uFF0C\u4F46\u90A3\u53E5\u88AB\u622A\u65AD\u7684\u665A\u5B89\uFF0C\u786E\u5B9E\u5DF2\u7ECF\u6709\u4EBA\u542C\u89C1\u3002"
    Pending: 0
  - Key: text.last_light_m5.last_light_line_radio_020
    SourceText: "\u4F60\u4EEC\u6536\u597D\u5F55\u97F3\u673A\uFF0C\u7EA6\u5B9A\u4EE5\u540E\u518D\u542C\u65F6\uFF0C\u4E0D\u5FC5\u6BCF\u6B21\u90FD\u628A\u4ECA\u665A\u8BB2\u5F97\u90D1\u91CD\u3002\u5B83\u4E5F\u53EF\u4EE5\u53EA\u662F\u4E00\u4E2A\u4E0B\u96E8\u540E\u3001\u6070\u597D\u6709\u4EBA\u613F\u610F\u7559\u4E0B\u7684\u508D\u665A\u3002"
    Pending: 0
  - Key: option.last_light_m5.last_light_choose_radio
    SourceText: "\u73B0\u5728\u64AD\u653E\u5F55\u97F3\uFF0C\u4E00\u8D77\u542C\u5B8C\u90A3\u53E5\u665A\u5B89"
    Pending: 0
  - Key: option.last_light_m5.last_light_choose_letter
    SourceText: "\u5148\u5199\u4E00\u5C01\u56DE\u4FE1\uFF0C\u7EA6\u5B9A\u4E0B\u6B21\u5F53\u9762\u542C"
    Pending: 0
  - Key: option.last_light_m5.last_light_heard_route
    SourceText: "\u6709\u4EBA\u542C\u89C1"
    Pending: 0
  - Key: prompt.last_light_m5.last_light_choice
    SourceText: "\u4ECA\u665A\uFF0C\u4F60\u60F3\u5148\u8FC8\u51FA\u54EA\u4E00\u6B65\uFF1F"
    Pending: 0
  - Key: chapter.last_light_m5.last_light_ch01
    SourceText: "\u6700\u540E\u4E00\u76CF\u706F"
    Pending: 0
